# Dockerfile for Queztl-Core Dashboard (Next.js static export)
FROM node:20-alpine as builder
WORKDIR /app
COPY dashboard ./dashboard
WORKDIR /app/dashboard
RUN npm install && npm run build && npm run export

FROM nginx:alpine
COPY --from=builder /app/dashboard/out /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
