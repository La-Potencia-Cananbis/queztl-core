version: "3.8"

services:
  gitea:
    build: .
    container_name: queztl-git
    restart: unless-stopped
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE=postgres
      - GITEA__database__HOST=db:5432
      - GITEA__database__NAME=gitea
      - GITEA__database__USER=gitea
      - GITEA__database__PASSWD=gitea
      - GITEA__server__DOMAIN=git.queztl.local
      - GITEA__server__SSH_DOMAIN=git.queztl.local
      - GITEA__server__ROOT_URL=http://git.queztl.local:3000/
      - GITEA__webhook__ALLOWED_HOST_LIST=*
      - GITEA__actions__ENABLED=true
    volumes:
      - gitea_data:/data
      - gitea_config:/etc/gitea
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3000:3000"
      - "2222:22"
    depends_on:
      - db
    networks:
      - gitea

  db:
    image: postgres:15-alpine
    container_name: queztl-git-db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=gitea
      - POSTGRES_PASSWORD=gitea
      - POSTGRES_DB=gitea
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - gitea

  # Git automation runner
  git-automation:
    build:
      context: .
      dockerfile: Dockerfile.automation
    container_name: queztl-git-automation
    restart: unless-stopped
    environment:
      - GITEA_URL=http://gitea:3000
      - GITEA_TOKEN=${GITEA_TOKEN}
      - BEAST_URL=http://192.168.1.105:8001
      - SLOTH_URL=http://192.168.1.102:9000
    volumes:
      - gitea_data:/data:ro
      - automation_logs:/logs
    depends_on:
      - gitea
    networks:
      - gitea

  # Redis for job queue
  redis:
    image: redis:7-alpine
    container_name: queztl-git-redis
    restart: unless-stopped
    volumes:
      - redis_data:/data
    networks:
      - gitea

volumes:
  gitea_data:
  gitea_config:
  postgres_data:
  redis_data:
  automation_logs:

networks:
  gitea:
    driver: bridge
