#!/usr/bin/env bash
# QueztlOS Bootstrap - Self-updating installer from GitHub
# Path: /usr/local/bin/queztl-bootstrap
# Always pulls latest from: https://github.com/La-Potencia-Cananbis/queztl-core

set -euo pipefail

REPO_URL="https://github.com/La-Potencia-Cananbis/queztl-core.git"
REPO_BRANCH="main"
INSTALL_DIR="/opt/queztl-core"
CACHE_DIR="$HOME/.cache/queztl"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Deployment mode/provider (can be overridden by flags)
MODE=""
PROVIDER=""
AWS_REGION="us-east-1"
ECR_REPO="queztl-git"
ACR_NAME="queztlregistry"
GCP_PROJECT="queztl-core"
K8S_NAMESPACE="queztl-git"

log() {
    echo -e "${GREEN}[QueztlOS]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
    exit 1
}

banner() {
    cat << 'BANNER_EOF'
╔══════════════════════════════════════════════════════════════╗
║  🦅 QUEZTLOS BOOTSTRAP INSTALLER                            ║
║  Self-updating from GitHub                                  ║
╚══════════════════════════════════════════════════════════════╝
BANNER_EOF
}

usage() {
    cat << USAGE_EOF
Usage: queztl-bootstrap [OPTIONS]

OPTIONS:
  --mode MODE           Specify deployment mode: gui | tui | headless
  --provider PROVIDER   Deployment target: local | aws | azure | gcp | k8s
  --aws-region REGION   AWS region (default: us-east-1)
  --ecr-repo NAME       ECR repository name (default: queztl-git)
  --acr-name NAME       Azure ACR name (default: queztlregistry)
  --gcp-project ID      GCP project ID (default: queztl-core)
  --k8s-namespace NS    Kubernetes namespace (default: queztl-git)
  --full                Install full stack (backend + frontend + cluster)
  --backend             Install backend only
  --frontend            Install frontend only
  --cluster ROLE        Join cluster as ROLE (orchestrator | compute)
  --git                 Install Git container system
  --update              Update existing installation
  -h, --help            Show this help

EXAMPLES:
  # Local Docker Compose install (auto-detect mode)
  queztl-bootstrap --provider local

  # AWS with specific region
  queztl-bootstrap --mode headless --provider aws --aws-region us-west-2

  # Full stack with GUI
  queztl-bootstrap --mode gui --full

  # Join cluster as compute node
  queztl-bootstrap --cluster compute

USAGE_EOF
}

detect_mode() {
    # If already set by flag, keep it
    if [ -n "$MODE" ]; then
        return
    fi
    
    # Auto-detect
    if [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
        MODE="gui"
        log "Auto-detected GUI mode (zenity available)"
    elif command -v whiptail >/dev/null 2>&1; then
        MODE="tui"
        log "Auto-detected TUI mode (whiptail available)"
    else
        MODE="headless"
        log "Auto-detected headless mode"
    fi
}

parse_args() {
    ACTION=""
    CLUSTER_ROLE=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode)
                MODE="$2"
                shift 2
                ;;
            --provider)
                PROVIDER="$2"
                shift 2
                ;;
            --aws-region)
                AWS_REGION="$2"
                shift 2
                ;;
            --ecr-repo)
                ECR_REPO="$2"
                shift 2
                ;;
            --acr-name)
                ACR_NAME="$2"
                shift 2
                ;;
            --gcp-project)
                GCP_PROJECT="$2"
                shift 2
                ;;
            --k8s-namespace)
                K8S_NAMESPACE="$2"
                shift 2
                ;;
            --full)
                ACTION="full"
                shift
                ;;
            --backend)
                ACTION="backend"
                shift
                ;;
            --frontend)
                ACTION="frontend"
                shift
                ;;
            --cluster)
                ACTION="cluster"
                CLUSTER_ROLE="$2"
                shift 2
                ;;
            --git)
                ACTION="git"
                shift
                ;;
            --update)
                ACTION="update"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                ;;
        esac
    done
    
    export ACTION CLUSTER_ROLE
}

update_repo() {
    log "Updating from GitHub: $REPO_URL"
    
    mkdir -p "$CACHE_DIR"
    
    if [ -d "$INSTALL_DIR/.git" ]; then
        log "Pulling latest changes..."
        cd "$INSTALL_DIR"
        git pull origin "$REPO_BRANCH" || warn "Failed to pull updates"
    else
        log "Cloning repository..."
        if [ -d "$INSTALL_DIR" ]; then
            sudo rm -rf "$INSTALL_DIR"
        fi
        sudo mkdir -p "$INSTALL_DIR"
        sudo chown "$(whoami):$(whoami)" "$INSTALL_DIR"
        git clone --branch "$REPO_BRANCH" "$REPO_URL" "$INSTALL_DIR"
    fi
    
    log "Repository updated successfully"
}

check_dependencies() {
    local deps=("git" "docker" "docker-compose" "python3")
    local missing=()
    
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing+=("$dep")
        fi
    done
    
    if [ ${#missing[@]} -gt 0 ]; then
        warn "Missing dependencies: ${missing[*]}"
        log "Installing dependencies..."
        
        if command -v apt-get &> /dev/null; then
            sudo apt-get update
            sudo apt-get install -y "${missing[@]}"
        elif command -v dnf &> /dev/null; then
            sudo dnf install -y "${missing[@]}"
        else
            error "Could not install dependencies. Please install manually: ${missing[*]}"
        fi
    fi
}

deploy_local() {
    log "Deploying to local machine with Docker Compose..."
    cd "$INSTALL_DIR"
    
    if [ -f "docker-compose.yml" ]; then
        log "Starting services..."
        docker-compose up -d
        log "Services started. Access at: http://localhost:8000"
    else
        error "docker-compose.yml not found in $INSTALL_DIR"
    fi
}

deploy_aws() {
    log "Deploying to AWS (region: $AWS_REGION, ECR: $ECR_REPO)..."
    cd "$INSTALL_DIR"
    
    if [ -f "infra/git-container/scripts/deploy-to-cloud.sh" ]; then
        bash infra/git-container/scripts/deploy-to-cloud.sh aws "$AWS_REGION" "$ECR_REPO"
    else
        error "AWS deployment script not found"
    fi
}

deploy_azure() {
    log "Deploying to Azure (ACR: $ACR_NAME)..."
    cd "$INSTALL_DIR"
    
    if [ -f "infra/git-container/scripts/deploy-to-cloud.sh" ]; then
        bash infra/git-container/scripts/deploy-to-cloud.sh azure "$ACR_NAME"
    else
        error "Azure deployment script not found"
    fi
}

deploy_gcp() {
    log "Deploying to GCP (project: $GCP_PROJECT)..."
    cd "$INSTALL_DIR"
    
    if [ -f "infra/git-container/scripts/deploy-to-cloud.sh" ]; then
        bash infra/git-container/scripts/deploy-to-cloud.sh gcp "$GCP_PROJECT"
    else
        error "GCP deployment script not found"
    fi
}

deploy_k8s() {
    log "Deploying to Kubernetes (namespace: $K8S_NAMESPACE)..."
    cd "$INSTALL_DIR"
    
    if [ -f "infra/git-container/scripts/deploy-to-cloud.sh" ]; then
        bash infra/git-container/scripts/deploy-to-cloud.sh k8s "$K8S_NAMESPACE"
    else
        error "Kubernetes deployment script not found"
    fi
}

run_installer() {
    case "$ACTION" in
        full)
            log "Installing full stack..."
            bash "$INSTALL_DIR/scripts/install-full-stack.sh" || error "Full stack installation failed"
            ;;
        backend)
            log "Installing backend only..."
            bash "$INSTALL_DIR/backend/install.sh" || error "Backend installation failed"
            ;;
        frontend)
            log "Installing frontend only..."
            bash "$INSTALL_DIR/frontend/install.sh" || error "Frontend installation failed"
            ;;
        cluster)
            log "Joining cluster as $CLUSTER_ROLE..."
            bash "$INSTALL_DIR/scripts/join-cluster.sh" "$CLUSTER_ROLE" || error "Cluster join failed"
            ;;
        git)
            log "Installing Git container system..."
            bash "$INSTALL_DIR/infra/git-container/scripts/setup-git-server.sh" || error "Git container setup failed"
            ;;
        update)
            log "Update complete. Latest code pulled from GitHub."
            ;;
        *)
            # If no action but provider specified, deploy to provider
            if [ -n "$PROVIDER" ]; then
                case "$PROVIDER" in
                    local)
                        deploy_local
                        ;;
                    aws)
                        deploy_aws
                        ;;
                    azure)
                        deploy_azure
                        ;;
                    gcp)
                        deploy_gcp
                        ;;
                    k8s)
                        deploy_k8s
                        ;;
                    *)
                        error "Unknown provider: $PROVIDER"
                        ;;
                esac
            else
                # Interactive menu
                show_menu
            fi
            ;;
    esac
}

show_menu() {
    case "$MODE" in
        gui)
            show_gui_menu
            ;;
        tui)
            show_tui_menu
            ;;
        headless)
            show_headless_menu
            ;;
    esac
}

show_gui_menu() {
    if ! command -v zenity >/dev/null 2>&1; then
        warn "zenity not available, falling back to TUI"
        show_tui_menu
        return
    fi
    
    choice=$(zenity --list \
        --title="QueztlOS Installer" \
        --text="Select installation option:" \
        --column="Option" --column="Description" \
        "full" "Full stack (Backend + Frontend + Cluster)" \
        "backend" "Backend only" \
        "frontend" "Frontend only" \
        "cluster" "Join cluster" \
        "git" "Git container system" \
        --width=500 --height=300) || exit 0
    
    case "$choice" in
        cluster)
            role=$(zenity --list \
                --title="Cluster Role" \
                --text="Select cluster role:" \
                --column="Role" \
                "orchestrator" \
                "compute" \
                --width=300 --height=200) || exit 0
            CLUSTER_ROLE="$role"
            ;;
    esac
    
    ACTION="$choice"
    run_installer
}

show_tui_menu() {
    if ! command -v whiptail >/dev/null 2>&1; then
        warn "whiptail not available, falling back to headless"
        show_headless_menu
        return
    fi
    
    choice=$(whiptail --title "QueztlOS Installer" --menu "Select installation option:" 20 70 7 \
        "full" "Full stack (Backend + Frontend + Cluster)" \
        "backend" "Backend only" \
        "frontend" "Frontend only" \
        "cluster" "Join cluster" \
        "git" "Git container system" \
        3>&1 1>&2 2>&3) || exit 0
    
    case "$choice" in
        cluster)
            role=$(whiptail --title "Cluster Role" --menu "Select cluster role:" 15 60 2 \
                "orchestrator" "Orchestrator node" \
                "compute" "Compute node" \
                3>&1 1>&2 2>&3) || exit 0
            CLUSTER_ROLE="$role"
            ;;
    esac
    
    ACTION="$choice"
    run_installer
}

show_headless_menu() {
    echo ""
    echo "QueztlOS Installation Options:"
    echo "1) Full stack (Backend + Frontend + Cluster)"
    echo "2) Backend only"
    echo "3) Frontend only"
    echo "4) Join cluster"
    echo "5) Git container system"
    echo "6) Update only"
    echo "0) Exit"
    echo ""
    read -rp "Select option [0-6]: " choice
    
    case "$choice" in
        1)
            ACTION="full"
            ;;
        2)
            ACTION="backend"
            ;;
        3)
            ACTION="frontend"
            ;;
        4)
            ACTION="cluster"
            read -rp "Cluster role (orchestrator/compute): " CLUSTER_ROLE
            ;;
        5)
            ACTION="git"
            ;;
        6)
            ACTION="update"
            ;;
        0)
            exit 0
            ;;
        *)
            error "Invalid option"
            ;;
    esac
    
    run_installer
}

main() {
    banner
    parse_args "$@"
    detect_mode
    check_dependencies
    update_repo
    run_installer
    
    log "✅ Installation complete!"
}

main "$@"
