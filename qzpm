        self.config_dir.mkdir(exist_ok=True)
        
        self.packages_file = self.config_dir / "packages.json"
        self.installed_file = self.config_dir / "installed.json"
        self.sources_file = self.config_dir / "sources.list"
        
        self.packages = self.load_packages()
        self.installed = self.load_installed()
        
