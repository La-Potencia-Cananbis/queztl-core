"""
QZPM - Queztl Package Manager
APT-like package manager for queztl-core distributed system
Manages dependencies, versions, and installations across Beast, Sloth, and cluster
"""

import json
import subprocess
import sys
from pathlib import Path
from typing import List, Dict, Optional
from datetime import datetime
import hashlib
import urllib.request
import shutil


class QZPM:
    """Queztl Package Manager"""
    
    def __init__(self):
